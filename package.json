{
  "name": "edu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tasks:dashboard": "node scripts/tasks-dashboard.mjs",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "content:check-extra": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content-extra.mjs",
    "audio:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audio-generate.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "test:e2e:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/e2e/setup/prepare-db.ts",
    "test:e2e": "npm run test:e2e:db && playwright test",
    "test:e2e:ui": "npm run test:e2e:db && playwright test --ui",
    "test:e2e:baocao": "playwright show-report playwright-report"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "kokoro-js": "^1.2.1",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
