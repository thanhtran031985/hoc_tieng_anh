# Biến môi trường của Edu (Học cùng Bông).
# Chép file này thành .env rồi điền giá trị thật. Không commit .env (đã có trong .gitignore).

# --- Database (Prisma, MySQL/MariaDB) ---
# Database `hoc_tieng_anh`, utf8mb4 / utf8mb4_unicode_ci. XAMPP mặc định: user root, không mật khẩu.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/hoc_tieng_anh"

# --- Auth.js / NextAuth v5 ---
# Mã hóa cookie phiên. Tạo bằng: npx auth secret
# KHÔNG để chuỗi rỗng: "" được coi là đã đặt và đăng nhập sẽ lỗi MissingSecret.
AUTH_SECRET=""

# Cần khi chạy bản production (next start / deploy); thiếu thì Auth.js từ chối request
# với lỗi UntrustedHost. Không cần cho `npm run dev`.
# AUTH_URL phải đúng origin thật (giao thức + host + cổng).
# AUTH_TRUST_HOST=true
# AUTH_URL="http://localhost:3000"

# --- Tài khoản quản trị mẫu (npx prisma db seed) ---
ADMIN_EMAIL="admin@edu.local"
# Tối thiểu 12 ký tự. Để trống khi phát triển để seed tự sinh mật khẩu ngẫu nhiên
# (in ra một lần). Bắt buộc khi production.
ADMIN_PASSWORD=""
