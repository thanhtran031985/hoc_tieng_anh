// Cơ sở dữ liệu Edu / Học cùng Bông (PRD Phần G, giai đoạn 1).
// Quy ước: model PascalCase số ít, @@map sang bảng snake_case số nhiều, field camelCase có @map sang cột snake_case.
// Chạy được trên MariaDB (XAMPP) và MySQL 8: không dùng tính năng riêng của một bên.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Import trong client sinh ra có đuôi .ts để Node chạy được prisma/seed.ts mà không cần công cụ build.
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Tài khoản và hồ sơ
// ---------------------------------------------------------------------------

enum Role {
  admin
  parent
}

enum UiTheme {
  tieu_hoc @map("tieu-hoc")
  thcs
  auto
}

/// Tài khoản gia đình (parent) và quản trị nội dung (admin).
model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(191)
  /// Mật khẩu đã băm bằng bcrypt, không bao giờ lưu dạng thuần.
  password  String   @db.VarChar(100)
  role      Role     @default(parent)
  /// Mã PIN phụ huynh (4–6 số) đã băm bằng bcrypt.
  parentPin String?  @map("parent_pin") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  learners Learner[]

  @@map("users")
}

/// Hồ sơ học sinh; mỗi hồ sơ thuộc một tài khoản gia đình.
model Learner {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  name           String    @db.VarChar(100)
  birthYear      Int?      @map("birth_year") @db.SmallInt
  schoolGrade    Int?      @map("school_grade") @db.TinyInt
  /// Bộ sách giáo khoa đang học ở trường (vd "Global Success").
  textbook       String?   @db.VarChar(100)
  /// Kiểu ảnh hồ sơ: short | bob | buns | spiky.
  avatar         String    @default("short") @db.VarChar(30)
  /// Màu rồng Bông: ngoc | dao | nang | tim.
  mascot         String    @default("ngoc") @db.VarChar(20)
  mascotName     String    @default("Bông") @map("mascot_name") @db.VarChar(50)
  uiTheme        UiTheme   @default(auto) @map("ui_theme")
  /// Cấp hiện tại của bé.
  currentLevelId Int?      @map("current_level_id")
  stars          Int       @default(0)
  coins          Int       @default(0)
  xp             Int       @default(0)
  streakDays     Int       @default(0) @map("streak_days")
  /// Thẻ nghỉ phép chuỗi ngày (mỗi tuần một thẻ).
  streakFreezes  Int       @default(1) @map("streak_freezes")
  lastStudyDate  DateTime? @map("last_study_date") @db.Date
  /// PIN hồ sơ đã băm bằng bcrypt.
  pin            String?   @db.VarChar(100)
  /// Cài đặt (JSON): giới hạn giờ, khung giờ, giọng đọc, mục tiêu ngày. Schema: src/lib/schemas/learner-settings.ts.
  settings       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLevel   Level?           @relation("LearnerCurrentLevel", fields: [currentLevelId], references: [id], onDelete: SetNull)
  lessonProgress LessonProgress[]
  lessonAttempts LessonAttempt[]
  answerLogs     AnswerLog[]
  reviewCards    ReviewCard[]
  recordings     Recording[]
  gameRecords    GameRecord[]
  rewards        LearnerReward[]
  examAttempts   ExamAttempt[]
  studySessions  StudySession[]

  @@index([userId])
  @@index([currentLevelId])
  @@map("learners")
}

// ---------------------------------------------------------------------------
// Lộ trình: chặng → cấp → chủ đề (unit) → bài học → bước trong bài
// ---------------------------------------------------------------------------

/// `planned`: chủ đề có trong khung chương trình nhưng chưa soạn nội dung (chỉ dùng cho units); học sinh chỉ thấy `published`.
enum ContentStatus {
  planned
  draft
  published
}

enum LessonKind {
  lesson
  unit_test
  level_test
  review
}

enum MediaType {
  image
  audio
}

/// 4 chặng: Khởi đầu, Tiểu học, THCS, Nâng cao.
model Stage {
  id        Int    @id @default(autoincrement())
  name      String @unique @db.VarChar(100)
  sortOrder Int    @map("sort_order")

  levels Level[]

  @@map("stages")
}

/// 10 cấp độ. `color` là tên token màu (level-1 … level-10), `theme` là bộ giao diện (tieu-hoc hoặc thcs).
model Level {
  id          Int    @id @default(autoincrement())
  stageId     Int    @map("stage_id")
  number      Int    @unique @db.TinyInt
  name        String @db.VarChar(100)
  /// Khung tham chiếu (Pre-A1, A1, A2, B1…).
  cefr        String @db.VarChar(30)
  description String @db.Text
  color       String @db.VarChar(30)
  theme       String @db.VarChar(20)

  stage     Stage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  units     Unit[]
  words     Word[]
  questions Question[]
  stories   Story[]
  exams     Exam[]
  learners  Learner[]  @relation("LearnerCurrentLevel")

  @@index([stageId])
  @@map("levels")
}

/// Chủ đề trong một cấp (vd Fruits).
model Unit {
  id          Int           @id @default(autoincrement())
  levelId     Int           @map("level_id")
  /// Khóa ổn định trong cấp (kebab-case), để seed và nhập Excel chạy lại không trùng.
  slug        String        @db.VarChar(100)
  title       String        @db.VarChar(150)
  titleVi     String        @map("title_vi") @db.VarChar(150)
  image       String?       @db.VarChar(255)
  /// Nguồn từ mục tiêu (vd Cambridge Starters).
  source      String?       @db.VarChar(100)
  /// Danh sách từ mục tiêu của chủ đề (mảng chuỗi), dùng để soạn nội dung và tạo bài.
  targetWords Json?         @map("target_words")
  sortOrder   Int           @map("sort_order")
  status      ContentStatus @default(draft)

  level   Level    @relation(fields: [levelId], references: [id], onDelete: Restrict)
  lessons Lesson[]
  stories Story[]

  @@unique([levelId, slug])
  @@index([levelId, sortOrder])
  @@map("units")
}

model Lesson {
  id        Int           @id @default(autoincrement())
  unitId    Int           @map("unit_id")
  title     String        @db.VarChar(150)
  kind      LessonKind    @default(lesson)
  sortOrder Int           @map("sort_order")
  minutes   Int           @default(10) @db.TinyInt
  status    ContentStatus @default(draft)

  unit        Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  steps       LessonStep[]
  progress    LessonProgress[]
  attempts    LessonAttempt[]
  gameRecords GameRecord[]

  @@index([unitId, sortOrder])
  @@map("lessons")
}

/// Một bước trong bài học: một dạng bài (`activity_type`) gắn với một từ hoặc một câu hỏi, cấu hình riêng ở `config` (JSON).
model LessonStep {
  id           Int    @id @default(autoincrement())
  lessonId     Int    @map("lesson_id")
  sortOrder    Int    @map("sort_order")
  /// word_card, listen_choose_picture, match_pairs, choose_word_for_picture… (kiểm bằng Zod).
  activityType String @map("activity_type") @db.VarChar(50)
  wordId       Int?   @map("word_id")
  questionId   Int?   @map("question_id")
  /// Schema: src/lib/schemas/lesson-step-config.ts.
  config       Json?

  lesson   Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word     Word?     @relation(fields: [wordId], references: [id], onDelete: Restrict)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([lessonId, sortOrder])
  @@index([wordId])
  @@index([questionId])
  @@map("lesson_steps")
}

// ---------------------------------------------------------------------------
// Nội dung: từ vựng, chủ đề từ, câu hỏi, thư viện hình và âm thanh
// ---------------------------------------------------------------------------

model Word {
  id           Int      @id @default(autoincrement())
  word         String   @db.VarChar(100)
  ipa          String?  @db.VarChar(100)
  partOfSpeech String?  @map("part_of_speech") @db.VarChar(30)
  meaningVi    String   @map("meaning_vi") @db.VarChar(255)
  exampleEn    String?  @map("example_en") @db.VarChar(500)
  exampleVi    String?  @map("example_vi") @db.VarChar(500)
  image        String?  @db.VarChar(255)
  audio        String?  @db.VarChar(255)
  exampleAudio String?  @map("example_audio") @db.VarChar(255)
  levelId      Int      @map("level_id")
  /// Họ từ, cụm từ đi kèm… Schema: src/lib/schemas/word-extra.ts.
  extra        Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  level       Level        @relation(fields: [levelId], references: [id], onDelete: Restrict)
  topics      WordTopic[]
  steps       LessonStep[]
  answerLogs  AnswerLog[]
  reviewCards ReviewCard[]

  @@index([word])
  @@index([levelId])
  @@map("words")
}

model Topic {
  id     Int    @id @default(autoincrement())
  name   String @unique @db.VarChar(100)
  nameVi String @map("name_vi") @db.VarChar(100)

  words WordTopic[]

  @@map("topics")
}

/// Một từ có thể thuộc nhiều chủ đề.
model WordTopic {
  wordId  Int @map("word_id")
  topicId Int @map("topic_id")

  word  Word  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([wordId, topicId])
  @@index([topicId])
  @@map("word_topic")
}

/// Ngân hàng câu hỏi. `prompt`, `options`, `answer` là JSON; schema: src/lib/schemas/question.ts.
model Question {
  id          Int           @id @default(autoincrement())
  type        String        @db.VarChar(50)
  prompt      Json
  options     Json?
  answer      Json
  explanation String?       @db.Text
  levelId     Int           @map("level_id")
  skill       String        @default("vocabulary") @db.VarChar(30)
  difficulty  Int           @default(1) @db.TinyInt
  status      ContentStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  level         Level          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  steps         LessonStep[]
  answerLogs    AnswerLog[]
  reviewCards   ReviewCard[]
  storyPages    StoryPage[]
  recordings    Recording[]
  examQuestions ExamQuestion[]

  @@index([levelId, type])
  @@map("questions")
}

/// Thư viện hình và âm thanh đã tải lên.
model Media {
  id        Int       @id @default(autoincrement())
  path      String    @unique @db.VarChar(255)
  type      MediaType
  /// Kích thước tệp (byte).
  size      Int
  alt       String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("media")
}

/// Cài đặt chung của cả hệ thống (không theo từng bé), dạng khóa → giá trị JSON, ví dụ `voice_mp3` = { "enabled": false }.
model AppSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Loại âm phonics: chữ đơn (a–z), âm ghép phụ âm (sh, ch, th, ck, ng), âm ghép nguyên âm (ee, oo, ai, ar, or).
enum PhonicsKind {
  single
  consonant_digraph
  vowel_digraph
}

/// Âm phonics cho bài Ghép âm (PRD Phần G, bảng phonics_sounds): 36 âm, mỗi âm có phiên âm, 2 từ ví dụ và tệp âm thanh.
model PhonicsSound {
  id        Int           @id @default(autoincrement())
  /// Chữ hoặc cụm chữ tạo ra âm, vd "c", "sh".
  grapheme  String        @unique @db.VarChar(8)
  kind      PhonicsKind
  /// Phiên âm, vd "/k/".
  ipa       String        @db.VarChar(16)
  /// Hai từ ví dụ: [{ "word": "cat", "part": "c" }] (part là phần chữ tạo ra âm, in đậm khi hiển thị).
  examples  Json
  /// Đường dẫn tệp âm thanh (`/audio/phonics-<id>-<mã>.mp3|wav`); chưa có thì ô chữ phát từ ví dụ thay cho âm.
  audio     String?       @db.VarChar(255)
  /// Độ dài tệp (mili giây).
  audioMs   Int?          @map("audio_ms")
  /// true: tệp do giọng đọc tự động tạo; false: tải lên.
  audioAuto Boolean       @default(false) @map("audio_auto")
  sortOrder Int           @map("sort_order")
  status    ContentStatus @default(published)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("phonics_sounds")
}

// ---------------------------------------------------------------------------
// Kết quả học
// ---------------------------------------------------------------------------

enum AnswerSource {
  lesson
  review
  exam
}

/// Kết quả tốt nhất của mỗi bài (mỗi bé một dòng cho mỗi bài).
model LessonProgress {
  id          Int       @id @default(autoincrement())
  learnerId   Int       @map("learner_id")
  lessonId    Int       @map("lesson_id")
  bestStars   Int       @default(0) @map("best_stars") @db.TinyInt
  attempts    Int       @default(0)
  completedAt DateTime? @map("completed_at")

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// Từng lần học một bài.
model LessonAttempt {
  id         Int       @id @default(autoincrement())
  learnerId  Int       @map("learner_id")
  lessonId   Int       @map("lesson_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  correct    Int       @default(0)
  wrong      Int       @default(0)
  stars      Int       @default(0) @db.TinyInt
  xp         Int       @default(0)
  coins      Int       @default(0)

  learner    Learner     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson     Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answerLogs AnswerLog[]

  @@index([learnerId, lessonId])
  @@index([learnerId, startedAt])
  @@index([lessonId])
  @@map("lesson_attempts")
}

/// Từng câu trả lời, dùng để thống kê kỹ năng và tìm từ hay sai.
model AnswerLog {
  id         BigInt       @id @default(autoincrement())
  learnerId  Int          @map("learner_id")
  questionId Int?         @map("question_id")
  wordId     Int?         @map("word_id")
  source     AnswerSource
  attemptId  Int?         @map("attempt_id")
  isCorrect  Boolean      @map("is_correct")
  /// Câu trả lời của bé. Schema: src/lib/schemas/answer-log.ts.
  answer     Json?
  timeMs     Int?         @map("time_ms")
  createdAt  DateTime     @default(now()) @map("created_at")

  learner  Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  question Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  word     Word?          @relation(fields: [wordId], references: [id], onDelete: SetNull)
  attempt  LessonAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([learnerId, createdAt])
  @@index([learnerId, wordId])
  @@index([questionId])
  @@index([wordId])
  @@index([attemptId])
  @@map("answer_logs")
}

/// Thẻ ôn tập lặp lại (5 hộp): mỗi thẻ gắn với một từ hoặc một câu hỏi.
model ReviewCard {
  id             Int       @id @default(autoincrement())
  learnerId      Int       @map("learner_id")
  wordId         Int?      @map("word_id")
  questionId     Int?      @map("question_id")
  /// Hộp 1–5.
  box            Int       @default(1) @db.TinyInt
  dueOn          DateTime  @map("due_on") @db.Date
  correctCount   Int       @default(0) @map("correct_count")
  wrongCount     Int       @default(0) @map("wrong_count")
  lastReviewedAt DateTime? @map("last_reviewed_at")

  learner  Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  word     Word?     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([learnerId, wordId])
  @@unique([learnerId, questionId])
  @@index([learnerId, dueOn])
  @@index([wordId])
  @@index([questionId])
  @@map("review_cards")
}

/// Phiên học, để tính phút học và giới hạn giờ.
model StudySession {
  id        Int       @id @default(autoincrement())
  learnerId Int       @map("learner_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  minutes   Int       @default(0)

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, startedAt])
  @@map("study_sessions")
}

/// Loại trang của truyện tranh: trang truyện (tranh + 1–2 câu) hoặc trang câu hỏi xen giữa.
enum StoryPageKind {
  page
  question
}

/// Truyện tranh có đọc to (dạng bài 8.6, task 16). Một truyện là một bước `story` trong bài (`lesson_steps.config.storyId`).
model Story {
  id        Int           @id @default(autoincrement())
  levelId   Int           @map("level_id")
  unitId    Int?          @map("unit_id")
  /// Khóa ổn định trong cấp (kebab-case), để seed chạy lại không trùng.
  slug      String        @db.VarChar(100)
  title     String        @db.VarChar(150)
  titleVi   String        @map("title_vi") @db.VarChar(150)
  cover     String?       @db.VarChar(255)
  /// Từ mới của truyện (mảng chữ thường), hiện ở trang "Hết truyện".
  newWords  Json          @map("new_words")
  status    ContentStatus @default(draft)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  level Level       @relation(fields: [levelId], references: [id], onDelete: Restrict)
  unit  Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  pages StoryPage[]

  @@unique([levelId, slug])
  @@index([levelId, sortOrder])
  @@index([unitId])
  @@map("stories")
}

/// Một trang của truyện. Trang `page` có tranh, `sentences` ([{ "en": "...", "vi": "..." }], 1–2 câu) và tệp âm thanh đọc;
/// trang `question` trỏ tới một dòng `questions` (type `story_question`).
model StoryPage {
  id         Int           @id @default(autoincrement())
  storyId    Int           @map("story_id")
  sortOrder  Int           @map("sort_order")
  kind       StoryPageKind @default(page)
  image      String?       @db.VarChar(255)
  sentences  Json
  /// Đường dẫn tệp âm thanh đọc trang (`/audio/story-<id>-<mã>.mp3`); chưa có thì chưa xuất bản được.
  audio      String?       @db.VarChar(255)
  questionId Int?          @map("question_id")

  story    Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([storyId, sortOrder])
  @@index([questionId])
  @@map("story_pages")
}

/// Bản ghi âm giọng bé ở bài Luyện nói (task 17). Tệp nằm ở `storage/recordings/<learner_id>/` (ngoài `public/`), trả về qua route kiểm quyền.
/// Mỗi (bé, câu hỏi) giữ tối đa 3 bản gần nhất.
model Recording {
  id         Int      @id @default(autoincrement())
  learnerId  Int      @map("learner_id")
  /// Câu luyện nói; null nếu câu đã bị xóa (bản ghi vẫn giữ để bố mẹ nghe lại).
  questionId Int?     @map("question_id")
  /// Câu mẫu bé đã nói, chép lại lúc ghi để còn hiện khi câu hỏi đã đổi hoặc bị xóa.
  sentence   String   @db.VarChar(255)
  /// Tên tệp đã lưu (`rec-<id>-<mã>.webm`).
  file       String   @db.VarChar(100)
  durationMs Int      @map("duration_ms")
  /// Số sao 1–3 (2 nếu không chấm).
  stars      Int      @db.TinyInt
  /// Chữ nhận diện được (null nếu không chấm).
  transcript String?  @db.VarChar(500)
  /// Có chấm bằng nhận diện giọng nói hay chỉ tính hoàn thành.
  scored     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  learner  Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([learnerId, questionId, createdAt])
  @@index([learnerId, createdAt])
  @@map("recordings")
}

/// Thành tích mini game (task 18). Xe ma của Đua xe đi theo `sequence` của lần chơi trước cùng bài, không chạy theo thời gian.
model GameRecord {
  id        Int      @id @default(autoincrement())
  learnerId Int      @map("learner_id")
  /// Tên trò: `rain`, `bubbles`, `whack`, `race`.
  game      String   @db.VarChar(20)
  lessonId  Int      @map("lesson_id")
  /// Số lượt đúng ngay lần đầu.
  correct   Int      @db.SmallInt
  /// Số lượt của trò.
  total     Int      @db.SmallInt
  /// Từng lượt trả lời theo thứ tự: 1 đúng, 0 chưa đúng.
  sequence  Json
  playedAt  DateTime @default(now()) @map("played_at")

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([learnerId, game, lessonId, playedAt])
  @@map("game_records")
}

/// Giọng đọc mp3 theo từng câu/đoạn chữ (task 19): câu của các dạng bài mới (sắp xếp câu, nghe-gõ, điền từ, đọc hiểu…) không nằm trong bảng từ vựng.
/// Tra cứu theo `text_key` (chữ đã chuẩn hóa như `audioKey`); `file` rỗng nghĩa là chưa tạo. Tệp ở storage/uploads/audio/ (kind `question`).
model AudioClip {
  id        Int      @id @default(autoincrement())
  textKey   String   @unique @map("text_key") @db.VarChar(500)
  /// Chữ gốc để đọc (đã gọn khoảng trắng).
  text      String   @db.VarChar(500)
  file      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audio_clips")
}

enum RewardType {
  sticker
  badge
  room_item
  avatar_frame
  theme
  title
}

/// Danh mục phần thưởng (PRD G). Task 20 nạp huy hiệu trùm cuối vùng (`boss:<cấp>:<chủ đề>`) và huy hiệu qua đảo (`level:<cấp>`); task 21 làm giao diện bộ sưu tập.
model Reward {
  id        Int        @id @default(autoincrement())
  type      RewardType
  /// Mã ổn định để nạp lại không trùng và để mã nguồn tham chiếu.
  code      String     @unique @db.VarChar(80)
  name      String     @db.VarChar(150)
  image     String?    @db.VarChar(255)
  /// Giá bằng xu (đồ trong cửa hàng); null nếu không bán.
  price     Int?
  /// Điều kiện nhận (JSON), vd `{"kind":"boss","level":2,"unit":"food-drink"}`.
  condition Json?
  /// Dáng rồng/cấp mà phần thưởng thuộc về (1–5), nếu có.
  forStage  Int?       @map("for_stage") @db.TinyInt
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")

  learnerRewards LearnerReward[]

  @@index([type, sortOrder])
  @@map("rewards")
}

/// Phần thưởng bé đã có.
model LearnerReward {
  id         Int      @id @default(autoincrement())
  learnerId  Int      @map("learner_id")
  rewardId   Int      @map("reward_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")
  equipped   Boolean  @default(false)
  /// Vị trí đồ trong phòng (JSON), dùng ở task 22.
  position   Json?

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([learnerId, rewardId])
  @@map("learner_rewards")
}

enum ExamKind {
  level_test
}

enum ExamAttemptStatus {
  in_progress
  passed
  retry
}

/// Đề thi. Task 20: mỗi cấp 1–4 một đề `level_test` (thi lên cấp, đạt từ `pass_percent`); các loại đề khác của PRD dùng ở giai đoạn sau.
model Exam {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(150)
  kind          ExamKind
  levelId       Int      @map("level_id")
  /// Số câu của một lượt thi và phần trăm câu đúng ngay lần đầu để đạt.
  questionCount Int      @default(20) @map("question_count")
  passPercent   Int      @default(80) @map("pass_percent") @db.TinyInt
  createdAt     DateTime @default(now()) @map("created_at")

  level     Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@unique([kind, levelId])
  @@map("exams")
}

/// Câu hỏi trong đề cố định (PRD). Bài thi lên cấp của task 20 tự dựng mỗi lượt thi (xem `exam_attempts.items`) nên chưa dùng bảng này; để dành cho đề cố định ở giai đoạn sau.
model ExamQuestion {
  id         Int @id @default(autoincrement())
  examId     Int @map("exam_id")
  questionId Int @map("question_id")
  sortOrder  Int @default(0) @map("sort_order")
  points     Int @default(1)

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@map("exam_questions")
}

/// Một lượt thi của bé. `items` là bộ 20 câu đã chọn khi bắt đầu (mã bước bài học + chủ đề), giữ nguyên để tải lại trang vẫn ra đúng bộ câu và để chấm lúc nộp.
model ExamAttempt {
  id          Int               @id @default(autoincrement())
  examId      Int               @map("exam_id")
  learnerId   Int               @map("learner_id")
  startedAt   DateTime          @default(now()) @map("started_at")
  submittedAt DateTime?         @map("submitted_at")
  status      ExamAttemptStatus @default(in_progress)
  /// Số câu đúng ngay lần đầu; null khi chưa nộp.
  score       Int?
  total       Int
  /// Bộ câu: [{ stepId, unitId }]. Schema: src/lib/schemas/exam.ts.
  items       Json
  /// Kết quả từng câu khi nộp: [{ stepId, correct }].
  answers     Json?
  /// Tối đa 3 chủ đề sai nhiều nhất: [{ unitId, wrong, total, wordIds }].
  weakUnits   Json?             @map("weak_units")

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, examId, startedAt])
  @@map("exam_attempts")
}
